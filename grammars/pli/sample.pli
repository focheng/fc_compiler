*CALL CSRRRP (A(1,1), M*N*KELEMENT_SIZE,                                00428313
*        RC,                                                            00428513
*        RSN);                                                          00428613

 beginBlock: begin;
 end beginBlock;

 /****************** IF Statement *******************************/
 if A = B then
   C = D;

 if A = B then
   C = D;
 else
   C = E;

 /****************** SELECT Statement *******************************/
 select (E);
   when (E1,E2,E3) call procedureE123;
   when (E4,E5)  call procedureE45;
   otherwise call procedureOtherwise;
 end;

 /****************** DO Statement ***********************************/
 /* basic repetitions */
 /* do Name = 'Tom', 'Dick', 'Harry' */
 do I = 1 to 10 by 2;
   A(I) = I;
 end;

 /* DO with WHILE, UNTIL */
 do while (A=B);
 end;
 do until (A=B); 
 end;
 do while(A=B) until(X=10);
 end;
 /* executes ten times while C(I) is less than zero, 
    and then (provided that A is equal to B) once more: */
 do I = 1 to 10 while (C(I)<0), 11 while (A = B);
 /* very useful when there is no value after the terminating value */
 do i = 2147483641 upthru 2147483647; 
 end;
 do level = High downthru Low;
 end;
 do I=1 repeat 2*I until(I=256);
 end;
	 
 /****************** ON Statement ***********************************/
 on error
 begin;
   display 'error happens';
 end;
 on FINISH system;
 on ANYCONDITION call Handle_all_others;

 /****************** Expression ***********************************/
 declare Result bit(3),
 A fixed decimal(1),
 B fixed binary (3),
 C character(2), D bit(4);
 Result = A + B**2 < C & D;	/* (((A + (B**2)) < C) & D) */

 END PLITEST;                                                           01080024
